{
  "title": "equip approval quote2",
  "description": "",
  "variables": {
    "backgroundColor": {
      "type": "string",
      "defaultValue": "dark-ocean"
    },
    "billingFrequencyListSDP": {
      "type": "vb/ServiceDataProvider",
      "defaultValue": {
        "endpoint": "businessObjects/getall_BillingFrequency",
        "keyAttributes": "billFreq",
        "itemsPath": "items",
        "responseType": "getallBillingFrequencyResponse",
        "transformsContext": {
          "vb-textFilterAttributes": [
            "billFreq"
          ]
        }
      }
    },
    "customerObject": {
      "type": "object"
    },
    "illustrationBackground": {
      "type": "string",
      "defaultValue": "https://static.oracle.com/cdn/fnd/gallery/2307.0.2/images/illust-welcome-banner-bg-01.png"
    },
    "illustrationForeground": {
      "type": "string",
      "defaultValue": "https://static.oracle.com/cdn/fnd/gallery/2307.0.2/images/illust-welcome-banner-fg-01.png"
    },
    "imageStretch": {
      "type": "string",
      "defaultValue": "none"
    },
    "mobileImage": {
      "type": "string",
      "defaultValue": "on"
    },
    "reserverdEquipmentDetails": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "reservedEqp"
      }
    },
    "selectedContactEmail": {
      "type": "string"
    },
    "selectedcontactname": {
      "type": "string"
    },
    "selectedEqpBillFreq": {
      "type": "string"
    },
    "selectedEqpQuoteAmount": {
      "type": "number"
    },
    "selectedEqpTaxAmount": {
      "type": "number"
    },
    "selectedEquipmentNumber": {
      "type": "string"
    },
    "selectedorgname": {
      "type": "string"
    },
    "updateQuote": {
      "type": "object[]"
    }

  },
  "metadata": {},
  "types": {
    "@decorators.getallBillingFrequencyResponse": {
      "endpoint": "getall_BillingFrequency",
      "service": "businessObjects",
      "path": "response"
    },
    "getallBillingFrequencyResponse": {
      "items": [
        {
          "billFreq": "string",
          "id": "number"
        }
      ]
    },
    "reservedEqp": {
      "customer_name": "string",
      "customer_site": "string",
      "end_date": "string",
      "equipment_class": "string",
      "equipment_id": "string",
      "equipment_name": "string",
      "equipment_number": "string",
      "equipment_type": "string",
      "insurance_end_date": "string",
      "insurance_issue_agent": "string",
      "insurance_policy": "string",
      "insurance_start_date": "string",
      "requestor_name": "string",
      "start_date": "string"
    }
  },
  "eventListeners": {
    "buttonAction": {
      "chains": [
        {
          "chain": "ButtonActionChain1",
          "parameters": {
            "current": "[[ $current.data ]]"
          }
        }
      ]
    },
    "buttonAction2": {
      "chains": [
        {
          "chain": "ButtonActionChain2"
        }
      ]
    },
    "buttonAction3": {
      "chains": [
        {
          "chain": "ButtonActionChain3"
        }
      ]
    },
    "buttonAction4": {
      "chains": [
        {
          "chain": "ButtonActionChain4"
        }
      ]
    },
    "inputNumberValue": {
      "chains": [
        {
          "chain": "InputNumberValueChangeChain",
          "parameters": {
            "value": "[[ $event.detail.value ]]"
          }
        }
      ]
    },
    "selectValueItem": {
      "chains": [
        {
          "chain": "SelectValueItemChangeChain",
          "parameters": {
            "key": "{{$event.detail.value.key}}",
            "data": "{{$event.detail.value.data}}",
            "metadata": "{{$event.detail.value.metadata}}"
          }
        }
      ]
    },
    "switchValue": {
      "chains": [
        {
          "chain": "SwitchValueChangeChain",
          "parameters": {
            "event": "{{$event}}",
            "previousValue": "{{$event.detail.previousValue}}",
            "value": "{{ $event.detail.value }}",
            "updatedFrom": "{{$event.detail.updatedFrom}}"
          }
        }
      ]
    },
    "vbEnter": {
      "chains": [
        {

          "chain": "PageVbEnterChain",
          "parameters": {
            "event": "{{$event}}"
      }
        }
      ]
    }

  },
  "imports": {
    "components": {
      "oj-button": {
        "path": "ojs/ojbutton"
      },
      "oj-dialog": {
        "path": "ojs/ojdialog"
      },
      "oj-form-layout": {
        "path": "ojs/ojformlayout"
      },
      "oj-highlight-text": {
        "path": "ojs/ojhighlighttext"
      },
      "oj-input-number": {
        "path": "ojs/ojinputnumber"
      },
      "oj-input-text": {
        "path": "ojs/ojinputtext"
      },
      "oj-label": {
        "path": "ojs/ojlabel"
      },
      "oj-select-single": {
        "path": "ojs/ojselectsingle"
      },
      "oj-sp-welcome-page": {
        "path": "oj-sp/welcome-page/loader"
      },
      "oj-switch": {
        "path": "ojs/ojswitch"
      }

   },
    "modules": {
      "ojConverterNumber": {
        "path": "ojs/ojconverter-number"
      },
      "ojValidationNumber": {
        "path": "ojs/ojvalidation-number"
      }

    }
  },
  "@dt": {
    "iconClass": "vbdt-dynamic-icon-90-icoWelcomePageTemplate48Svg"
  }
}