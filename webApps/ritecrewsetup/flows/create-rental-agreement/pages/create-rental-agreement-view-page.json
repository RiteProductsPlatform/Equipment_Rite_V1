{
  "title": "create rental agreement view",
  "description": "",
  "variables": {
    "addlineObj": {
      "type": "lineObj"
    },
    "agrNumber": {
      "type": "string"
    },
    "backgroundColor": {
      "type": "string",
      "defaultValue": "dark-ocean"
    },
    "curencyAdp": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "application:getCurrenciesLOV",
        "keyAttributes": "CurrencyCode"
      }
    },
    "getGetEquipmentClassesListSDP": {
      "type": "vb/ServiceDataProvider",
      "defaultValue": {
        "endpoint": "TimeRite_Ords_Service/getGetEquipmentClasses",
        "keyAttributes": "eqp_class_details",
        "itemsPath": "items",
        "responseType": "getGetEquipmentClassesResponse",
        "uriParameters": {
          "page_name": "{{ \"equipment-requisition-start\" }}"
        },
        "transformsContext": {
          "vb-textFilterAttributes": [
            "eqp_class_details"
          ]
        }
      }
    },
    "getGetEquipmentClassesListSDP2": {
      "type": "vb/ServiceDataProvider",
      "defaultValue": {
        "endpoint": "TimeRite_Ords_Service/getGetEquipmentClasses",
        "keyAttributes": "eqp_class_details",
        "itemsPath": "items",
        "responseType": "getGetEquipmentClassesResponse2",
        "uriParameters": {
          "page_name": "{{ \"equipment-requisition-start\" }}"
        },
        "transformsContext": {
          "vb-textFilterAttributes": [
            "eqp_class_details"
          ]
        }
      }
    },
    "getGetEquipmentLOVListSDP": {
      "type": "vb/ServiceDataProvider",
      "defaultValue": {
        "endpoint": "TimeRite_Ords_Service/getGetEquipmentLOV",
        "keyAttributes": "lkpvalue",
        "itemsPath": "items",
        "responseType": "getGetEquipmentLOVResponse",
        "uriParameters": {
          "pClass": "{{ $variables.lineObj.equipment_class }}"
        },
        "transformsContext": {
          "vb-textFilterAttributes": [
            "lkpvalue"
          ]
        }
      }
    },
    "getGetEquipmentLOVListSDP2": {
      "type": "vb/ServiceDataProvider",
      "defaultValue": {
        "endpoint": "TimeRite_Ords_Service/getGetEquipmentLOV",
        "keyAttributes": "lkpvalue",
        "itemsPath": "items",
        "responseType": "getGetEquipmentLOVResponse2",
        "transformsContext": {
          "vb-textFilterAttributes": [
            "lkpvalue"
          ]
        },
        "uriParameters": {
          "pClass": "{{ $variables.addlineObj.eqp_class }}"
        }
      }
    },
    "illustrationBackground": {
      "type": "string",
      "defaultValue": "https://static.oracle.com/cdn/fnd/gallery/2307.0.2/images/illust-welcome-banner-bg-01.png"
    },
    "illustrationForeground": {
      "type": "string",
      "defaultValue": "https://static.oracle.com/cdn/fnd/gallery/2307.0.2/images/illust-welcome-banner-fg-01.png"
    },
    "imageStretch": {
      "type": "string",
      "defaultValue": "none"
    },
    "isBtnDisabled": {
      "type": "boolean",
      "defaultValue": true
    },
    "lineObj": {
      "type": "getEQPRite_AgreementLines"
    },
    "linesAdp": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "getEQPRite_AgreementLines",
        "keyAttributes": "line_id"
      }
    },
    "mobileImage": {
      "type": "string",
      "defaultValue": "on"
    },
    "rowdata": {
      "type": "getEQPRite_AgreementLines"
    },
    "selectedRow": {
      "type": "object",
      "input": "fromCaller"
    },
    "tableSelectedAdp": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "getEQPRite_AgreementLines",
        "keyAttributes": "line_id"
      }
    },
    "uomAdp": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "application:getAllUOM",
        "keyAttributes": "UOM"
      }
    }

  },
  "metadata": {},
  "types": {
    "@decorators.getEQPRite_AgreementLines": {
      "endpoint": "getEQPRite_AgreementLines",
      "service": "TimeRite_Ords_Service",
      "path": "response-_-items[0]"
    },
    "@decorators.getGetEquipmentClassesResponse": {
      "endpoint": "getGetEquipmentClasses",
      "service": "TimeRite_Ords_Service",
      "path": "response"
    },
    "@decorators.getGetEquipmentClassesResponse2": {
      "endpoint": "getGetEquipmentClasses",
      "service": "TimeRite_Ords_Service",
      "path": "response"
    },
    "@decorators.getGetEquipmentLOVResponse": {
      "endpoint": "getGetEquipmentLOV",
      "service": "TimeRite_Ords_Service",
      "path": "response"
    },
    "@decorators.getGetEquipmentLOVResponse2": {
      "endpoint": "getGetEquipmentLOV",
      "service": "TimeRite_Ords_Service",
      "path": "response"
    },
    "getGetEquipmentClassesResponse": {
      "items": [
        {
          "eqp_class_details": "string"
        }
      ]
    },
    "getGetEquipmentClassesResponse2": {
      "items": [
        {
          "eqp_class_details": "string"
        }
      ]
    },
    "getGetEquipmentLOVResponse": {
      "items": [
        {
          "default_location": "string",
          "equipment_class": "string",
          "equipment_name": "string",
          "equipment_number": "string",
          "equipment_type": "string",
          "lkpid": "number",
          "lkpvalue": "string"
        }
      ]
    },
    "getGetEquipmentLOVResponse2": {
      "items": [
        {
          "default_location": "string",
          "equipment_class": "string",
          "equipment_name": "string",
          "equipment_number": "string",
          "equipment_type": "string",
          "lkpid": "number",
          "lkpvalue": "string",
          "mf_serial_number": "string"
        }
      ]
    },
    "lineObj": {
      "currency": "string",
      "eqp_class": "string",
      "eqp_id": "string",
      "eqp_name": "string",
      "eqp_namenumber": "string",
      "eqp_number": "string",
      "id": "number",
      "item_desc": "string",
      "item_number": "string",
      "lot_number": "string",
      "notes": "string",
      "prjnamenumber": "string",
      "projectid": "string",
      "projectname": "string",
      "projectnumber": "string",
      "quantity": "number",
      "rate_amount": "string",
      "rate_basis": "string",
      "rental_type": "string",
      "taskid": "number",
      "taskname": "string",
      "tasknumber": "string",
      "uom": "string",
      "valid_from": "string",
      "valid_to": "string",
      "ware_house": "string"
    },
    "getEQPRite_AgreementLines": {
      "agreement_id": "number",
      "bill_rate": "string",
      "comments": "any",
      "currency": "string",
      "equipment_class": "string",
      "equipment_id": "number",
      "equipment_name": "string",
      "equipment_number": "string",
      "equipment_type": "any",
      "file_content": "string",
      "line_id": "number",
      "line_number": "any",
      "lot_number": "string",
      "project_id": "any",
      "project_name": "any",
      "project_name_number": "any",
      "project_number": "any",
      "quantity": "number",
      "rate_amount": "any",
      "rate_basis": "any",
      "rental_type_code": "any",
      "status_code": "string",
      "task_id": "any",
      "task_name": "any",
      "task_number": "any",
      "uom": "string",
      "valid_from": "string",
      "valid_to": "string"

    }

  },
  "eventListeners": {
    "addLineBtnAction": {
      "chains": [
        {
          "chain": "SaveLineButtonActionChain",
          "parameters": {
            "event": "{{$event}}",
            "originalEvent": "{{$event.detail.originalEvent}}"
          }
        }
      ]
    },
    "buttonAction": {
      "chains": [
        {
          "chain": "backButtonActionChain",
          "parameters": {
            "event": "{{$event}}",
            "originalEvent": "{{$event.detail.originalEvent}}"
          }
        }
      ]
    },
    "buttonAction2": {
      "chains": [
        {
          "chain": "CreateRequestButtonActionChain",
          "parameters": {
            "event": "{{$event}}",
            "originalEvent": "{{$event.detail.originalEvent}}"
          }
        }
      ]
    },
    "buttonAction3": {
      "chains": [
        {
          "chain": "editButtonActionChain",
          "parameters": {
            "event": "{{$event}}",
            "originalEvent": "{{$event.detail.originalEvent}}",
            "key": "{{ $current.key }}",
            "index": "{{ $current.index }}",
            "current": "{{ $current }}"
          }
        }
      ]
    },
    "buttonAction4": {
      "chains": [
        {
          "chain": "AddLineButtonActionChain",
          "parameters": {
            "event": "{{$event}}",
            "originalEvent": "{{$event.detail.originalEvent}}"
          }
        }
      ]
    },
    "buttonAction5": {
      "chains": [
        {
          "chain": "ResetButtonActionChain",
          "parameters": {
            "event": "{{$event}}",
            "originalEvent": "{{$event.detail.originalEvent}}"
          }
        }
      ]
    },
    "cancelBtnAction": {
      "chains": [
        {
          "chain": "CloseButtonActionChain",
          "parameters": {
            "event": "{{$event}}",
            "originalEvent": "{{$event.detail.originalEvent}}"
          }
        }
      ]
    },
    "closeAddLineBtnAction": {
      "chains": [
        {
          "chain": "ButtonActionChain",
          "parameters": {
            "event": "{{$event}}",
            "originalEvent": "{{$event.detail.originalEvent}}"
          }
        }
      ]
    },
    "selectValueItem": {
      "chains": [
        {
          "chain": "eqpClassSelectValueItemChangeChain",
          "parameters": {
            "event": "{{$event}}",
            "previousValue": "{{$event.detail.previousValue}}",
            "value": "{{$event.detail.value}}",
            "updatedFrom": "{{$event.detail.updatedFrom}}",
            "key": "{{$event.detail.value.key}}",
            "data": "{{$event.detail.value.data}}",
            "metadata": "{{$event.detail.value.metadata}}",
            "valueItem": "{{ $event.detail.value }}"
          }
        }
      ]
    },
    "selectValueItem2": {
      "chains": [
        {
          "chain": "eqpNameSelectValueItemChangeChain",
          "parameters": {
            "event": "{{$event}}",
            "previousValue": "{{$event.detail.previousValue}}",
            "value": "{{$event.detail.value}}",
            "updatedFrom": "{{$event.detail.updatedFrom}}",
            "key": "{{$event.detail.value.key}}",
            "data": "{{$event.detail.value.data}}",
            "metadata": "{{$event.detail.value.metadata}}",
            "valueItem": "{{ $event.detail.value }}"
          }
        }
      ]
    },
    "tableBeforeRowEdit": {
      "chains": [
        {
          "chain": "TableBeforeRowEditChain",
          "parameters": {
            "event": "{{$event}}",
            "accept": "{{$event.detail.accept}}",
            "rowContext": "{{$event.detail.rowContext}}",
            "rowKey": "{{$event.detail.rowContext.status.rowKey}}",
            "rowIndex": "{{$event.detail.rowContext.status.rowIndex}}",
            "rowData": "{{$event.detail.rowContext.componentElement.getDataForVisibleRow($event.detail.rowContext.status.rowIndex).data}}"
          }
        }
      ]
    },
    "tableBeforeRowEditEnd": {
      "chains": [
        {
          "chain": "TableBeforeRowEditEndChain",
          "parameters": {
            "event": "{{$event}}",
            "accept": "{{$event.detail.accept}}",
            "setUpdatedItem": "{{$event.detail.setUpdatedItem}}",
            "rowContext": "{{$event.detail.rowContext}}",
            "cancelEdit": "{{$event.detail.cancelEdit}}",
            "rowKey": "{{$event.detail.rowContext.status.rowKey}}",
            "rowIndex": "{{$event.detail.rowContext.status.rowIndex}}",
            "rowData": "{{$event.detail.rowContext.componentElement.getDataForVisibleRow($event.detail.rowContext.status.rowIndex).data}}"
          }
        }
      ]
    },
    "tableSelected": {
      "chains": [
        {
          "chain": "TableSelectedChangeChain",
          "parameters": {
            "event": "{{$event}}",
            "previousValue": "{{$event.detail.previousValue}}",
            "value": "{{$event.detail.value}}",
            "updatedFrom": "{{$event.detail.updatedFrom}}",
            "keys": "{{ $event.detail.value.row.values ? Array.from($event.detail.value.row.values()) : [] }}",
            "selected": "{{ $event.detail.value }}"
          }
        }
      ]
    },
    "vbEnter": {
      "chains": [
        {
          "chain": "PageVbEnterChain",
          "parameters": {
            "event": "{{$event}}"
          }
        }
      ]
    }

  },
  "imports": {
    "components": {
      "oj-button": {
        "path": "ojs/ojbutton"
      },
      "oj-dialog": {
        "path": "ojs/ojdialog"
      },
      "oj-form-layout": {
        "path": "ojs/ojformlayout"
      },
      "oj-input-date": {
        "path": "ojs/ojdatetimepicker"
      },
      "oj-input-number": {
        "path": "ojs/ojinputnumber"
      },
      "oj-input-text": {
        "path": "ojs/ojinputtext"
      },
      "oj-popup": {
        "path": "ojs/ojpopup"
      },
      "oj-progress-bar": {
        "path": "ojs/ojprogress-bar"
      },
      "oj-select-single": {
        "path": "ojs/ojselectsingle"
      },
      "oj-sp-welcome-page": {
        "path": "oj-sp/welcome-page/loader"
      },
      "oj-table": {
        "path": "ojs/ojtable"
      },
      "oj-text-area": {
        "path": "ojs/ojinputtext"
      },
      "oj-validation-group": {
        "path": "ojs/ojvalidationgroup"
      }
    }
  },
  "@dt": {
    "iconClass": "vbdt-dynamic-icon-15-icoWelcomePageTemplate48Svg"
  }
}